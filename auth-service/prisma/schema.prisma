// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(OPERATOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VehicleStatus {
  IN_TRAFFIC
  PARKED
  MAINTENANCE
}

model Vehicle {
  id           Int           @id @default(autoincrement())
  brand        String
  model        String
  licensePlate String        @unique
  status       VehicleStatus @default(PARKED)
  ownerId      Int

  positions Position[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Position {
  id        Int      @id @default(autoincrement())
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())

  vehicleId Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
}

enum TrafficLevel {
  LOW
  MEDIUM
  HIGH
}

model TrafficZone {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  latitude  Float?
  longitude Float?
  density   Int          @default(0)
  status    TrafficLevel @default(LOW)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum IncidentType {
  ACCIDENT
  ROADWORK
  ROAD_CLOSED
  TRAFFIC_JAM
}

enum IncidentStatus {
  REPORTED
  IN_PROGRESS
  RESOLVED
}

model Incident {
  id          Int            @id @default(autoincrement())
  title       String
  type        IncidentType
  status      IncidentStatus @default(REPORTED)
  latitude    Float?
  longitude   Float?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  userId    Int
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
